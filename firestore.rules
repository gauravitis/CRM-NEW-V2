rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all collections
    match /{document=**} {
      allow read, write: if true;
    }

    // Specific collection rules (for later use)
    match /items/{item} {
      allow read: if true;
      allow write: if true;
    }

    match /clients/{client} {
      allow read: if true;
      allow write: if true;
    }

    match /employees/{employee} {
      allow read: if true;
      allow write: if true;
    }

    match /quotations/{quotation} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{order} {
      allow read: if true;
      allow write: if true;
    }
  }
} 